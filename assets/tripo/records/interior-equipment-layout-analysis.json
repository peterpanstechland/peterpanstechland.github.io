  "integration": {
    "loadOrder": "shell/floor -> existing showcase/new office desk/new workbench/PC -> tabletop equipment -> reused second monitor",
    "supportConfigSuggested": {
      "supportAsset": "maker_workbench or office_desk or 01_garage_shell",
      "supportSurface": "top or interior-floor",
      "surfaceYLocal": "numeric tabletop top after verified mesh, not whole mesh maxY if backsplash exists"
    },
    "algorithm": "Preserve config reset for idempotence; update parent world matrices -> mount.updateMatrixWorld(true) -> skeleton.update(); construct only actual horizontal support triangles in table top Y band, settle actual low-foot samples on support. Require all samples supported; track max floor variation, actual tabletop overhang and ceiling collision. Do not fall back to street for desk objects.",
    "missingSupport": "Keep dependent device hidden/unavailable with explicit support-unavailable state until its real desk/bench is ready; retry parent and refresh dependency order. Never show it floating at floor.",
    "clones": "One monitor load, two instances sharing GPU resources. Track both instances and do not dispose shared resources when only one instance/group is removed.",
    "normalizedScaling": "Current normalized=true branch ignores targetHeight/targetSize; introduce explicit uniformScale or placement.scale.setScalar(.78) for retained showcase. Do not pretend changing targetHeight alone resizes it.",
    "statedLimit": "Compact game display; not a real workshop ergonomic/layout certification. No chair, extraction equipment, open lids/doors swept volume designed in this proposed 10-model set.",
    "levelFeet": "Native floor varies about 55-60mm beneath workbench and 24mm beneath office desk. Keep tops horizontal; extend each actual foot down to its sampled floor (locallyAuthored support hardware) or tune leg endpoints locally. If no supported triangle at a real foot, move table; do not bridge empty air with a fake floor.",
    "finalValidation": "After real equipment GLBs: whole-mesh ceiling/wall overlap, all actual feet/support contacts, table surface vs devices, PC vs leg/braces, door swept volume, load-failure parent/child states, mobile memory. This envelope report is not final visual acceptance."
  }
